# --- Auth (required) ---
# Generate with: npx auth secret
AUTH_SECRET=

# Production only: the public URL of the deployment (e.g. https://grcai.up.railway.app)
# AUTH_URL=

# --- Sign-in providers ---
# Demo login ("Continue as demo analyst"). Auto-enabled when Entra is not configured;
# set to "true" to force it on even alongside Microsoft SSO.
DEMO_LOGIN=true

# Microsoft Entra ID SSO (optional — leave empty to use demo login only)
# Redirect URI to register: <AUTH_URL>/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<TENANT_ID>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# --- Claude API (optional) ---
# Leave empty to run in simulated mode (built-in demo drafting engine, no API calls).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_MAX_TOKENS=32000

# --- Storage ---
# SQLite file location. On Railway, mount a volume at /data and set /data/grcai.db
DATABASE_PATH=./data/grcai.db
